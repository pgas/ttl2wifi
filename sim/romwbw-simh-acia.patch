diff --git a/Source/HBIOS/Config/SBC_simh_dual.asm b/Source/HBIOS/Config/SBC_simh_dual.asm
new file mode 100644
index 00000000..4c81cd1e
--- /dev/null
+++ b/Source/HBIOS/Config/SBC_simh_dual.asm
@@ -0,0 +1,15 @@
+;
+;==================================================================================================
+;   ROMWBW BUILD SETTINGS FOR N8VEM SBC W/SIMH SUPPORT AND DUAL SERIAL
+;==================================================================================================
+;
+#INCLUDE "Config/SBC_simh_std.asm"
+
+AUTOCON		.SET	FALSE		; DISABLE CONSOLE TAKEOVER AT LOADER PROMPT
+ACIAENABLE	.SET	TRUE		; ACIA: ENABLE MOTOROLA 6850 ACIA DRIVER (ACIA.ASM)
+ACIA_POLL	.SET	TRUE		; ACIA: USE POLLED I/O (AltairZ80 M2SIO)
+ACIACNT		.SET	1		; ACIA: NUMBER OF CHIPS TO DETECT
+ACIA0BASE	.SET	$10		; ACIA 0: REGISTERS BASE ADR (AltairZ80 M2SIO0)
+ACIA0CLK	.SET	153600		; ACIA 0: OSC FREQ (153600 / 16 = 9600 BAUD)
+ACIA0DIV	.SET	1		; ACIA 0: SERIAL CLOCK DIVIDER
+ACIA0CFG	.SET	SER_9600_8N1	; ACIA 0: SERIAL LINE CONFIG
