 ACIADEBUG	.EQU	FALSE		; ACIA: ENABLE DEBUG OUTPUT
 ACIACNT		.EQU	1		; ACIA: NUMBER OF CHIPS TO DETECT (1-2)
 ACIA0BASE	.EQU	$80		; ACIA 0: REGISTERS BASE ADR
