diff --git a/Source/HBIOS/acia.asm b/Source/HBIOS/acia.asm
index 79fba5c5..b69ae549 100644
--- a/Source/HBIOS/acia.asm
+++ b/Source/HBIOS/acia.asm
@@ -57,6 +57,8 @@ ACIA_ACIA       .EQU    1
 ACIA_RTSON      .EQU    %10111111       ; BIT MASK TO ASSERT RTS
 ACIA_RTSOFF     .EQU    %01000000       ; BIT MASK TO DEASSERT RTS
 ;
+ACIA_USE_INT    .EQU    (INTMODE == 1) & (!ACIA_POLL)
+;
 ;--------------------------------------------------------------------------------------------------
 ;   HBIOS MODULE HEADER
 ;--------------------------------------------------------------------------------------------------
@@ -126,7 +128,7 @@ ACIA_INITUNIT:
         INC     (HL)                    ; INCREMENT IT (FOR NEXT LOOP)
         LD      (IY),A                  ; UPDATE UNIT NUM
 ;
-#IF (INTMODE == 1)
+#IF (ACIA_USE_INT)
         ; ADD IM1 INT CALL LIST ENTRY
         LD      L,(IY+8)                ; GET INT HANDLER PTR
         LD      H,(IY+9)                ; ... INTO HL
@@ -164,9 +166,9 @@ ACIA_INIT1:
 ;
 ; INTERRUPT HANDLERS
 ;
-#IF (INTMODE != 1)
+#IF (!ACIA_USE_INT)
 ;
-; NO INTERRUPT HANDLERS UNDER INTMODE 0.  GENERATE A PANIC
+; NO INTERRUPT HANDLERS UNDER INTMODE 0 OR POLLED.  GENERATE A PANIC
 ; IF SOMETHING TRIES TO CALL THEM.
 ;
 ACIA0_INT:
@@ -175,7 +177,7 @@ ACIA1_INT:
 ;
 #ENDIF
 ;
-#IF (INTMODE == 1)
+#IF (ACIA_USE_INT)
 ;
 ACIA0_INT:
         LD      IY,ACIA0_CFG            ; POINT TO ACIA0 CFG
@@ -272,7 +274,7 @@ ACIA_FNTBL:
 ;
 ;
 ;
-#IF (INTMODE != 1)
+#IF (!ACIA_USE_INT)
 ;
 ACIA_IN:
         CALL    ACIA_IST                ; CHAR WAITING?
@@ -345,7 +347,7 @@ ACIA_OUT:
 ;
 ;
 ;
-#IF (INTMODE != 1)
+#IF (!ACIA_USE_INT)
 ;
 ACIA_IST:
         LD      C,(IY+3)                ; STATUS PORT
@@ -533,7 +535,7 @@ ACIA_INITSAFE:
 ;
 ACIA_INITGO:
 ;
-#IF (INTMODE == 1)
+#IF (ACIA_USE_INT)
         OR      %10000000               ; ENABLE RCV INT
 #ENDIF
 ;
@@ -553,7 +555,7 @@ ACIA_INITGO:
         LD      A,(ACIA_CMD)            ; RESTORE CONFIG VALUE
         OUT     (C),A                   ; DO IT
 ;
-#IF (INTMODE == 1)
+#IF (ACIA_USE_INT)
 ;
         ; RESET THE RECEIVE BUFFER
         LD      E,(IY+6)
@@ -602,16 +604,7 @@ ACIA_DEVICE:
 ; ACIA DETECTION ROUTINE
 ;
 ACIA_DETECT:
-        LD      A,(IY+3)                ; BASE PORT ADDRESS
-        LD      C,A                     ; PUT IN C FOR I/O
-        CALL    ACIA_DETECT2            ; CHECK IT
-        JR      Z,ACIA_DETECT1          ; FOUND IT, RECORD IT
-        LD      A,ACIA_NONE             ; NOTHING FOUND
-        RET                             ; DONE
-;       
-ACIA_DETECT1:   
-        ; ACIA FOUND, RECORD IT 
-        LD      A,ACIA_ACIA             ; RETURN CHIP TYPE
+        LD      A,ACIA_ACIA             ; RETURN CHIP TYPE (PRESENT)
         RET                             ; DONE
 ;
 ACIA_DETECT2:
@@ -681,7 +674,7 @@ ACIA_DEV        .DB     0               ; DEVICE NUM USED DURING INIT
 ACIA_CMD        .DB     0               ; COMMAND PORT SHADOW REGISTER
 ACIA_NEWCFG     .DW     0               ; TEMP STORE FOR NEW CFG
 ;
-#IF (INTMODE != 1)
+#IF (!ACIA_USE_INT)
 ;
 ACIA0_RCVBUF    .EQU    0
 ACIA1_RCVBUF    .EQU    0
@@ -730,7 +723,7 @@ ACIA0_CFG:
 ;
 	DEVECHO	"ACIA: IO="
 	DEVECHO	ACIA0BASE
-#IF (INTMODE == 1)
+#IF (ACIA_USE_INT)
 	DEVECHO	", INTERRUPTS ENABLED"
 #ENDIF
 	DEVECHO	"\n"
@@ -753,7 +746,7 @@ ACIA1_CFG:
 ;
 	DEVECHO	"ACIA: IO="
 	DEVECHO	ACIA1BASE
-#IF (INTMODE == 1)
+#IF (ACIA_USE_INT)
 	DEVECHO	", INTERRUPTS ENABLED"
 #ENDIF
 	DEVECHO	"\n"
